#. Description of the plugin
#: simple-seo.php
#: includes/class-simple-seo-github-updater.php:102
msgid "A lightweight SEO plugin for WordPress."
msgstr "Легкий SEO-плагін для WordPress."

#. Author of the plugin
#: simple-seo.php
msgid "Vitalii Kaplia"
msgstr "Vitalii Kaplia"

#. Author URI of the plugin
#: simple-seo.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-seo-access.php:117
msgid "Change the settings"
msgstr "Змінювати налаштування"

#: includes/class-simple-seo-access.php:118
msgid "Open this page and change any Simple SEO settings. Administrators always can."
msgstr "Відкривати цю сторінку й змінювати будь-які налаштування Simple SEO. Адміністратори можуть завжди."

#: includes/class-simple-seo-access.php:121
msgid "Edit SEO fields"
msgstr "Редагувати SEO-поля"

#: includes/class-simple-seo-access.php:122
msgid "The SEO title, description and other basic fields of the posts, pages and terms the user can edit anyway."
msgstr "SEO-заголовок, опис та інші основні поля записів, сторінок і термінів, які користувач і так може редагувати."

#: includes/class-simple-seo-access.php:125
msgid "Edit indexing fields"
msgstr "Редагувати поля індексації"

#: includes/class-simple-seo-access.php:126
msgid "Fields that decide whether and how search engines index a page: robots, canonical address. A wrong value can take a page out of search."
msgstr "Поля, що вирішують, чи індексують пошуковики сторінку і як: robots, канонічна адреса. Хибне значення може прибрати сторінку з пошуку."

#: includes/class-simple-seo-admin.php:32
msgid "Access"
msgstr "Доступ"

#: includes/class-simple-seo-admin.php:62
#: includes/class-simple-seo-editor.php:28
#: includes/class-simple-seo-editor.php:109
#: includes/class-simple-seo-scores.php:112
msgid "SEO"
msgstr "SEO"

#: includes/class-simple-seo-admin.php:70
#: includes/class-simple-seo-admin.php:230
msgid "Settings"
msgstr "Налаштування"

#: includes/class-simple-seo-admin.php:121
#: includes/class-simple-seo-bulk.php:278
msgid "Sorry, you are not allowed to access this page."
msgstr "На жаль, у вас немає доступу до цієї сторінки."

#. translators: %s: name of another SEO plugin, e.g. Yoast SEO.
#: includes/class-simple-seo-admin.php:147
#, php-format
msgid "%s is active, so Simple SEO prints nothing on the site — no titles, descriptions or other tags — and pages never get them twice. Deactivate it when you switch to Simple SEO; the settings and fields here can be prepared in the meantime."
msgstr "%s активний, тому Simple SEO нічого не виводить на сайті — ні заголовків, ні описів, ні інших тегів, — і сторінки ніколи не отримують їх двічі. Вимкніть його, коли переходитимете на Simple SEO; налаштування й поля тут можна підготувати заздалегідь."

#: includes/class-simple-seo-admin.php:205
msgid "Choose an image"
msgstr "Оберіть зображення"

#: includes/class-simple-seo-admin.php:206
msgid "Use this image"
msgstr "Використати це зображення"

#: includes/class-simple-seo-admin.php:208
msgid "Choose image"
msgstr "Обрати зображення"

#: includes/class-simple-seo-admin.php:209
msgid "Remove image"
msgstr "Прибрати зображення"

#: includes/class-simple-seo-admin.php:220
msgid "Insert structure"
msgstr "Вставити структуру"

#: includes/class-simple-seo-aioseo-cleanup.php:61
msgid "AIOSEO's tables: the SEO fields of posts (what the import took), its cache, notifications and the like"
msgstr "Таблиці AIOSEO: SEO-поля записів (те, що взяв імпорт), його кеш, сповіщення тощо"

#: includes/class-simple-seo-aioseo-cleanup.php:62
msgid "AIOSEO's other options, cached data, scheduled tasks and the capabilities it gave to roles"
msgstr "Інші опції AIOSEO, кешовані дані, заплановані задачі й права, які він додав ролям"

#: includes/class-simple-seo-aioseo-cleanup.php:63
msgid "AIOSEO's settings: search appearance, social networks, sitemaps and the rest"
msgstr "Налаштування AIOSEO: вигляд у пошуку, соцмережі, карти сайту й решта"

#: includes/class-simple-seo-aioseo-cleanup.php:64
msgid "AIOSEO's data of users: notices put off and the like"
msgstr "Дані AIOSEO у користувачах: відкладені сповіщення тощо"

#: includes/class-simple-seo-aioseo-cleanup.php:65
msgid "AIOSEO's copies of the fields of posts in post meta (_aioseo_title and the like)"
msgstr "Копії полів записів AIOSEO в їхній меті (_aioseo_title тощо)"

#: includes/class-simple-seo-aioseo-import.php:99
msgid "AIOSEO's #tags become Simple SEO's {variables}. A tag Simple SEO has no counterpart for is left out of the text and named in the report."
msgstr "#теги AIOSEO стають {змінними} Simple SEO. Тег, якому в Simple SEO немає відповідника, прибрано з тексту й названо у звіті."

#: includes/class-simple-seo-analysis.php:39
msgid "Content analysis"
msgstr "Аналіз контенту"

#: includes/class-simple-seo-analysis.php:43
msgid "Focus keyphrase"
msgstr "Основна ключова фраза"

#: includes/class-simple-seo-analysis.php:44
msgid "The words people search for to find this page. The analysis below checks the page for them."
msgstr "Слова, якими люди шукають цю сторінку. Аналіз нижче перевіряє, чи вони є на сторінці."

#. translators: %d: how many.
#: includes/class-simple-seo-analysis.php:54
#, php-format
msgid "More keyphrases, up to %d"
msgstr "Додаткові ключові фрази, до %d"

#: includes/class-simple-seo-analysis.php:55
msgid "One on a line: other searches this page answers. The analysis counts them in the text."
msgstr "По одній у рядку: інші запити, на які відповідає сторінка. Аналіз рахує їх у тексті."

#: includes/class-simple-seo-analysis.php:124
msgid "Set a focus keyphrase: the checks below then look for it on the page."
msgstr "Вкажіть основну ключову фразу — тоді перевірки нижче шукатимуть її на сторінці."

#. translators: %s: score out of 100.
#: includes/class-simple-seo-analysis.php:181
#, php-format
msgid "SEO score: %s of 100"
msgstr "SEO-оцінка: %s зі 100"

#. translators: %s: score out of 100.
#: includes/class-simple-seo-analysis.php:183
#, php-format
msgid "Readability: %s of 100"
msgstr "Читабельність: %s зі 100"

#: includes/class-simple-seo-analysis.php:184
msgid "Readability"
msgstr "Читабельність"

#: includes/class-simple-seo-analysis.php:185
msgid "The analysis could not be updated; it shows the page as it was."
msgstr "Не вдалося оновити аналіз: він показує сторінку такою, якою вона була."

#: includes/class-simple-seo-analysis.php:229
msgid "The keyphrase is short enough to be searched for as it is."
msgstr "Ключова фраза досить коротка, щоб її шукали саме так."

#: includes/class-simple-seo-analysis.php:230
msgid "The keyphrase is long: few people search for more than four words at once."
msgstr "Ключова фраза довга: мало хто шукає більш ніж чотирма словами."

#: includes/class-simple-seo-analysis.php:233
msgid "The SEO title has the keyphrase."
msgstr "SEO-заголовок має ключову фразу."

#: includes/class-simple-seo-analysis.php:234
msgid "The SEO title does not have the keyphrase: put it in, nearer the start the better."
msgstr "SEO-заголовок не має ключової фрази: додайте її, краще ближче до початку."

#: includes/class-simple-seo-analysis.php:237
msgid "The meta description has the keyphrase."
msgstr "Мета-опис має ключову фразу."

#: includes/class-simple-seo-analysis.php:238
msgid "The meta description does not have the keyphrase: search engines highlight it there."
msgstr "Мета-опис не має ключової фрази: пошуковики виділяють її там."

#: includes/class-simple-seo-analysis.php:241
msgid "The address of the page has the keyphrase."
msgstr "Адреса сторінки має ключову фразу."

#: includes/class-simple-seo-analysis.php:242
msgid "The address of the page does not have the keyphrase: put its words into the slug."
msgstr "Адреса сторінки не має ключової фрази: внесіть її слова в слаг."

#: includes/class-simple-seo-analysis.php:252
msgid "The first paragraph has the keyphrase."
msgstr "Перший абзац має ключову фразу."

#: includes/class-simple-seo-analysis.php:253
msgid "The first paragraph does not have the keyphrase: say early what the page is about."
msgstr "Перший абзац не має ключової фрази: скажіть одразу, про що сторінка."

#: includes/class-simple-seo-analysis.php:258
msgid "A subheading has the keyphrase."
msgstr "Ключова фраза є в підзаголовку."

#: includes/class-simple-seo-analysis.php:259
msgid "No subheading has the keyphrase: use it, or its words, in one of them."
msgstr "Жоден підзаголовок не має ключової фрази: вживіть її або її слова в одному з них."

#: includes/class-simple-seo-analysis.php:266
msgid "The text does not have the keyphrase."
msgstr "У тексті немає ключової фрази."

#. translators: 1: how many times, 2: share of the words, in per cent.
#: includes/class-simple-seo-analysis.php:270
#, php-format
msgid "The keyphrase is in the text %1$s times, %2$s%% of the words: too often, it reads as stuffing."
msgstr "Входжень ключової фрази в текст: %1$s, це %2$s%% слів — забагато, текст читається як переспам."

#. translators: 1: how many times, 2: share of the words, in per cent.
#: includes/class-simple-seo-analysis.php:274
#, php-format
msgid "The keyphrase is in the text %1$s times, %2$s%% of the words: it could be there more often."
msgstr "Входжень ключової фрази в текст: %1$s, це %2$s%% слів — її могло б бути більше."

#. translators: %s: how many times.
#: includes/class-simple-seo-analysis.php:277
#, php-format
msgid "The keyphrase is in the text %s times."
msgstr "Входжень ключової фрази в текст: %s."

#: includes/class-simple-seo-analysis.php:283
msgid "The alt text of an image has the keyphrase."
msgstr "Alt-текст зображення має ключову фразу."

#: includes/class-simple-seo-analysis.php:284
msgid "No image has the keyphrase in its alt text."
msgstr "Жодне зображення не має ключової фрази в alt-тексті."

#. translators: %s: titles of other posts.
#: includes/class-simple-seo-analysis.php:290
#, php-format
msgid "The same keyphrase is the focus of other pages too: %s. Pages on one search compete with each other."
msgstr "Ця ж ключова фраза — основна й для інших сторінок: %s. Сторінки під один запит конкурують між собою."

#: includes/class-simple-seo-analysis.php:291
msgid "No other page has this focus keyphrase."
msgstr "Жодна інша сторінка не має цієї основної ключової фрази."

#. translators: 1: a keyphrase, 2: how many times.
#: includes/class-simple-seo-analysis.php:305
#, php-format
msgid "\"%1$s\" is in the text %2$s times."
msgstr "«%1$s» — входжень у текст: %2$s."

#. translators: %s: a keyphrase.
#: includes/class-simple-seo-analysis.php:307
#, php-format
msgid "\"%s\" is not in the text."
msgstr "«%s» немає в тексті."

#. translators: %s: number of words.
#: includes/class-simple-seo-analysis.php:320
#, php-format
msgid "The text has %s words."
msgstr "Слів у тексті: %s."

#. translators: %s: number of words.
#: includes/class-simple-seo-analysis.php:322
#, php-format
msgid "The text has %s words: search engines favour pages that say more; 300 is a good start."
msgstr "Слів у тексті: %s. Пошуковики віддають перевагу сторінкам, що кажуть більше; 300 — добрий початок."

#. translators: %s: number of links.
#: includes/class-simple-seo-analysis.php:328
#, php-format
msgid "Links to other pages of the site: %s."
msgstr "Посилань на інші сторінки сайту: %s."

#: includes/class-simple-seo-analysis.php:329
msgid "No links to other pages of the site: they help visitors and search engines find them."
msgstr "Немає посилань на інші сторінки сайту: вони допомагають відвідувачам і пошуковикам їх знайти."

#. translators: %s: number of links.
#: includes/class-simple-seo-analysis.php:332
#, php-format
msgid "Links to other sites: %s."
msgstr "Посилань на інші сайти: %s."

#: includes/class-simple-seo-analysis.php:333
msgid "No links to other sites: a link to a good source makes the text more trustworthy."
msgstr "Немає посилань на інші сайти: посилання на добре джерело додає тексту довіри."

#. translators: %s: number of images.
#: includes/class-simple-seo-analysis.php:339
#, php-format
msgid "Images: %s."
msgstr "Зображень: %s."

#: includes/class-simple-seo-analysis.php:340
msgid "No images: a picture makes a page easier to read and can come up in image search."
msgstr "Немає зображень: малюнок робить сторінку легшою для читання і може з'явитися в пошуку зображень."

#. translators: %s: number of images.
#: includes/class-simple-seo-analysis.php:343
#, php-format
msgid "Images without alt text: %s. Describe what they show, for search engines and for people who do not see them."
msgstr "Зображень без alt-тексту: %s. Опишіть, що на них, — для пошуковиків і для людей, які їх не бачать."

#: includes/class-simple-seo-analysis.php:346
msgid "The page has no SEO title of Simple SEO: the theme's title stays."
msgstr "Сторінка не має SEO-заголовка від Simple SEO: лишається заголовок теми."

#: includes/class-simple-seo-analysis.php:347
msgid "The page has no meta description: search engines will show a piece of its text."
msgstr "Сторінка не має мета-опису: пошуковики покажуть уривок її тексту."

#: includes/class-simple-seo-analysis.php:366
#: includes/class-simple-seo-bulk.php:316
#: includes/class-simple-seo-titles.php:53
msgid "SEO title"
msgstr "SEO-заголовок"

#: includes/class-simple-seo-analysis.php:366
#: includes/class-simple-seo-bulk.php:316
#: includes/class-simple-seo-titles.php:63
msgid "Meta description"
msgstr "Мета-опис"

#. translators: 1: SEO title or Meta description, 2: number of characters, 3: its width in pixels, 4: the width search results give it.
#: includes/class-simple-seo-analysis.php:370
#, php-format
msgid "%1$s: %2$s characters, %3$s pixels wide of %4$s: search engines will cut its end."
msgstr "%1$s: символів — %2$s, ширина %3$s із %4$s пікселів: пошуковики обріжуть кінець."

#. translators: 1: SEO title or Meta description, 2: number of characters.
#: includes/class-simple-seo-analysis.php:374
#, php-format
msgid "%1$s: %2$s characters, short: a search result has room for more."
msgstr "%1$s: символів — %2$s, короткий: у видачі є місце ще для слів."

#. translators: 1: SEO title or Meta description, 2: number of characters.
#: includes/class-simple-seo-analysis.php:378
#, php-format
msgid "%1$s: %2$s characters, a good length."
msgstr "%1$s: символів — %2$s, добра довжина."

