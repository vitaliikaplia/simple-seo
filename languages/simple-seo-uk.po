#. Plugin Name of the plugin
#: simple-seo.php
#: includes/class-simple-seo-admin.php:60
#: includes/views/settings.php:14
msgid "Simple SEO"
msgstr "Simple SEO"

#. Description of the plugin
#: simple-seo.php
#: includes/class-simple-seo-github-updater.php:102
msgid "A lightweight SEO plugin for WordPress."
msgstr "Легкий SEO-плагін для WordPress."

#. Author of the plugin
#: simple-seo.php
msgid "Vitalii Kaplia"
msgstr "Vitalii Kaplia"

#. Author URI of the plugin
#: simple-seo.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-seo-access.php:117
msgid "Change the settings"
msgstr "Змінювати налаштування"

#: includes/class-simple-seo-access.php:118
msgid "Open this page and change any Simple SEO settings. Administrators always can."
msgstr "Відкривати цю сторінку й змінювати будь-які налаштування Simple SEO. Адміністратори можуть завжди."

#: includes/class-simple-seo-access.php:121
msgid "Edit SEO fields"
msgstr "Редагувати SEO-поля"

#: includes/class-simple-seo-access.php:122
msgid "The SEO title, description and other basic fields of the posts, pages and terms the user can edit anyway."
msgstr "SEO-заголовок, опис та інші основні поля записів, сторінок і термінів, які користувач і так може редагувати."

#: includes/class-simple-seo-access.php:125
msgid "Edit indexing fields"
msgstr "Редагувати поля індексації"

#: includes/class-simple-seo-access.php:126
msgid "Fields that decide whether and how search engines index a page: robots, canonical address. A wrong value can take a page out of search."
msgstr "Поля, що вирішують, чи індексують пошуковики сторінку і як: robots, канонічна адреса. Хибне значення може прибрати сторінку з пошуку."

#: includes/class-simple-seo-admin.php:32
msgid "Access"
msgstr "Доступ"

#: includes/class-simple-seo-admin.php:61
#: includes/class-simple-seo-editor.php:28
#: includes/class-simple-seo-editor.php:103
msgid "SEO"
msgstr "SEO"

#: includes/class-simple-seo-admin.php:118
msgid "Sorry, you are not allowed to access this page."
msgstr "На жаль, у вас немає доступу до цієї сторінки."

#. translators: %s: name of another SEO plugin, e.g. Yoast SEO.
#: includes/class-simple-seo-admin.php:144
#, php-format
msgid "%s is active, so Simple SEO prints nothing on the site — no titles, descriptions or other tags — and pages never get them twice. Deactivate it when you switch to Simple SEO; the settings and fields here can be prepared in the meantime."
msgstr "%s активний, тому Simple SEO нічого не виводить на сайті — ні заголовків, ні описів, ні інших тегів, — і сторінки ніколи не отримують їх двічі. Вимкніть його, коли переходитимете на Simple SEO; налаштування й поля тут можна підготувати заздалегідь."

#: includes/class-simple-seo-admin.php:179
msgid "Insert structure"
msgstr "Вставити структуру"

#: includes/class-simple-seo-admin.php:189
msgid "Settings"
msgstr "Налаштування"

#: includes/class-simple-seo-editor.php:45
#: includes/class-simple-seo-editor.php:112
#: includes/class-simple-seo-indexing.php:99
msgid "Indexing"
msgstr "Індексація"

#. translators: %s: the title or description the page has with the saved values.
#: includes/class-simple-seo-editor.php:195
#, php-format
msgid "Now: %s"
msgstr "Зараз: %s"

#: includes/class-simple-seo-editor.php:196
msgid "Now: none from Simple SEO."
msgstr "Зараз: від Simple SEO нічого."

#: includes/class-simple-seo-github-updater.php:103
msgid "Version 0.4.0: canonical address on every page search engines may show; Indexing tab — which kinds of pages search engines may show, where attachment pages go; noindex and nofollow for each post, page and term. Version 0.3.0: page title and meta description from the SEO fields and from templates with variables; Titles tab; \"Insert structure\" button. While another SEO plugin is active, nothing is printed."
msgstr "Версія 0.4.0: канонічна адреса на кожній сторінці, яку можуть показувати пошуковики; вкладка «Індексація» — які види сторінок показувати в пошуку й куди ведуть сторінки вкладень; noindex і nofollow для кожного запису, сторінки й терміна. Версія 0.3.0: заголовок сторінки й мета-опис із SEO-полів і з шаблонів зі змінними; вкладка «Заголовки»; кнопка «Вставити структуру». Поки активний інший SEO-плагін, нічого не виводиться."

#: includes/class-simple-seo-indexing.php:61
msgid "Search engines"
msgstr "Пошуковики"

#: includes/class-simple-seo-indexing.php:65
msgid "As set for this type of page"
msgstr "Як налаштовано для цього виду сторінок"

#: includes/class-simple-seo-indexing.php:66
#: includes/views/tab-indexing.php:76
msgid "Show in search results"
msgstr "Показувати в результатах пошуку"

#: includes/class-simple-seo-indexing.php:67
msgid "Hide from search results (noindex)"
msgstr "Не показувати в результатах пошуку (noindex)"

#: includes/class-simple-seo-indexing.php:71
msgid "hidden from search results"
msgstr "прихована від пошуковиків"

#: includes/class-simple-seo-indexing.php:72
msgid "shown in search results"
msgstr "показується в результатах пошуку"

#: includes/class-simple-seo-indexing.php:78
msgid "Ask search engines not to follow the links on this page (nofollow)"
msgstr "Просити пошуковики не переходити за посиланнями з цієї сторінки (nofollow)"

#: includes/class-simple-seo-indexing.php:87
msgid "Canonical address"
msgstr "Канонічна адреса"

#: includes/class-simple-seo-indexing.php:88
msgid "Only when this page repeats another one: the address of the original. Leave empty for the page's own address."
msgstr "Лише коли ця сторінка повторює іншу: адреса оригіналу. Залиште порожнім, щоб узяти власну адресу сторінки."

#: includes/class-simple-seo-titles.php:51
msgid "SEO title"
msgstr "SEO-заголовок"

#: includes/class-simple-seo-titles.php:52
msgid "The title search engines show. Leave empty to use the template; variables like {title}, {sep} and {site} work here too."
msgstr "Заголовок, який показують пошуковики. Залиште порожнім, щоб узяти шаблон; змінні на кшталт {title}, {sep} і {site} працюють і тут."

#: includes/class-simple-seo-titles.php:61
msgid "Meta description"
msgstr "Мета-опис"

#: includes/class-simple-seo-titles.php:62
msgid "The text under the title in search results. Leave empty to use the template."
msgstr "Текст під заголовком у результатах пошуку. Залиште порожнім, щоб узяти шаблон."

#: includes/class-simple-seo-titles.php:72
msgid "Titles"
msgstr "Заголовки"

#. translators: %s: post type name, plural.
#: includes/class-simple-seo-titles.php:253
#, php-format
msgid "Archive: %s"
msgstr "Архів: %s"

#: includes/class-simple-seo-titles.php:256
msgid "Author archives"
msgstr "Архіви авторів"

#: includes/class-simple-seo-titles.php:257
msgid "Date archives"
msgstr "Архіви за датами"

#: includes/class-simple-seo-titles.php:258
msgid "Search results"
msgstr "Результати пошуку"

#: includes/class-simple-seo-titles.php:262
msgid "Post types"
msgstr "Типи записів"

#: includes/class-simple-seo-titles.php:266
msgid "Taxonomies"
msgstr "Таксономії"

#: includes/class-simple-seo-titles.php:270
msgid "Archives and search"
msgstr "Архіви й пошук"

#: includes/class-simple-seo-variables.php:46
msgid "Title of the post, term, archive or author; on search results and 404 a ready phrase"
msgstr "Назва запису, терміна чи архіву або ім'я автора; на сторінках пошуку й 404 — готова фраза"

#: includes/class-simple-seo-variables.php:47
msgid "Site title"
msgstr "Назва сайту"

#: includes/class-simple-seo-variables.php:48
msgid "Tagline"
msgstr "Короткий опис сайту"

#: includes/class-simple-seo-variables.php:49
msgid "Separator chosen in the settings"
msgstr "Роздільник, обраний у налаштуваннях"

#: includes/class-simple-seo-variables.php:50
msgid "Page number, only from the second page on: \"Page 2 of 5\""
msgstr "Номер сторінки, лише з другої: «Сторінка 2 з 5»"

#: includes/class-simple-seo-variables.php:51
msgid "Excerpt of the post (or the start of its text), description of the term, author or post type"
msgstr "Витяг запису (або початок його тексту), опис терміна, автора чи типу записів"

#: includes/class-simple-seo-variables.php:52
msgid "Category of the post"
msgstr "Рубрика запису"

#: includes/class-simple-seo-variables.php:53
msgid "Author name"
msgstr "Ім'я автора"

#: includes/class-simple-seo-variables.php:54
msgid "Publication date of the post, or the date of a date archive"
msgstr "Дата публікації запису або дата архіву за датами"

#: includes/class-simple-seo-variables.php:55
msgid "Name of the post type"
msgstr "Назва типу записів"

#: includes/class-simple-seo-variables.php:56
msgid "What was searched for"
msgstr "Що шукали"

#: includes/class-simple-seo-variables.php:57
msgid "Current year"
msgstr "Поточний рік"

#. translators: %s: what was searched for.
#: includes/class-simple-seo-variables.php:114
#, php-format
msgid "Search results for \"%s\""
msgstr "Результати пошуку за «%s»"

#: includes/class-simple-seo-variables.php:116
msgid "Page not found"
msgstr "Сторінку не знайдено"

#. translators: 1: page number, 2: number of pages.
#: includes/class-simple-seo-variables.php:131
#, php-format
msgid "Page %1$d of %2$d"
msgstr "Сторінка %1$d з %2$d"

#. translators: %d: page number.
#: includes/class-simple-seo-variables.php:133
#, php-format
msgid "Page %d"
msgstr "Сторінка %d"

#. translators: format of a month archive date, see https://www.php.net/manual/datetime.format.php
#: includes/class-simple-seo-variables.php:214
msgctxt "month archive date format"
msgid "F Y"
msgstr "F Y"

#: includes/views/tab-access.php:14
msgid "Choose which roles can do what. Editing SEO fields of a post or term also needs the right to edit that post or term itself."
msgstr "Оберіть, які ролі що можуть. Щоб редагувати SEO-поля запису чи терміна, потрібне ще й право редагувати сам запис чи термін."

#: includes/views/tab-indexing.php:16
#: includes/views/tab-indexing.php:32
msgid "Attachment pages"
msgstr "Сторінки вкладень"

#: includes/views/tab-indexing.php:18
msgid "Choose which kinds of pages search engines may show. A hidden kind gets \"noindex\"; links on it are still followed. Each post, page or term can override its kind in its own SEO fields. Search results and the 404 page are always hidden."
msgstr "Оберіть, які види сторінок можуть показувати пошуковики. Прихований вид отримує «noindex», але посилання з нього пошуковики все одно проходять. Кожен запис, сторінка чи термін може перевизначити це у своїх SEO-полях. Результати пошуку й сторінка 404 приховані завжди."

#. translators: %s: link to Settings → Reading.
#: includes/views/tab-indexing.php:25
#, php-format
msgid "The whole site is hidden from search engines in %s, whatever is chosen here."
msgstr "Увесь сайт приховано від пошуковиків у %s, що б тут не було обрано."

#: includes/views/tab-indexing.php:26
msgid "Settings → Reading"
msgstr "Налаштування → Читання"

#: includes/views/tab-indexing.php:36
#: includes/views/tab-indexing.php:39
msgid "An attachment page"
msgstr "Сторінка вкладення"

#: includes/views/tab-indexing.php:42
msgid "redirects to the file itself (recommended)"
msgstr "веде на сам файл (рекомендовано)"

#: includes/views/tab-indexing.php:43
msgid "redirects to the post it is attached to, or to the file when there is none"
msgstr "веде на запис, до якого прикріплено файл, а якщо такого немає — на сам файл"

#: includes/views/tab-indexing.php:44
msgid "stays a page of its own"
msgstr "лишається окремою сторінкою"

#: includes/views/tab-indexing.php:52
msgid "WordPress makes a page for every uploaded file. It has nothing but the image, so search engines rate it as thin content."
msgstr "WordPress створює сторінку для кожного завантаженого файлу. На ній немає нічого, крім зображення, тож пошуковики вважають її порожньою сторінкою."

#: includes/views/tab-titles.php:30
msgid "Templates decide the title and the description of every page that has no SEO title or description of its own. Variables in curly braces are replaced on each page; a variable with nothing to show disappears together with the separator next to it. An empty template leaves the page with the theme's title and without a description."
msgstr "Шаблони визначають заголовок і опис кожної сторінки, яка не має власного SEO-заголовка чи опису. Змінні у фігурних дужках замінюються на кожній сторінці; змінна, якій нічого показати, зникає разом із роздільником поруч. Порожній шаблон лишає сторінці заголовок теми й не дає їй опису."

#: includes/views/tab-titles.php:33
msgid "Variables"
msgstr "Змінні"

#: includes/views/tab-titles.php:49
#: includes/views/tab-titles.php:52
msgid "Separator"
msgstr "Роздільник"

#: includes/views/tab-titles.php:61
msgid "Goes where a template says {sep}."
msgstr "Стоїть там, де в шаблоні {sep}."

#: includes/views/tab-titles.php:83
msgid "Title template"
msgstr "Шаблон заголовка"

#: includes/views/tab-titles.php:84
msgid "Description template"
msgstr "Шаблон опису"
