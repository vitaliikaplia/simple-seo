#. Plugin Name of the plugin
#: simple-seo.php
#: includes/class-simple-seo-admin.php:60
#: includes/views/settings.php:14
msgid "Simple SEO"
msgstr "Simple SEO"

#. Description of the plugin
#: simple-seo.php
#: includes/class-simple-seo-github-updater.php:102
msgid "A lightweight SEO plugin for WordPress."
msgstr "Легкий SEO-плагін для WordPress."

#. Author of the plugin
#: simple-seo.php
msgid "Vitalii Kaplia"
msgstr "Vitalii Kaplia"

#. Author URI of the plugin
#: simple-seo.php
msgid "https://kaplia.pro/"
msgstr "https://kaplia.pro/"

#: includes/class-simple-seo-access.php:117
msgid "Change the settings"
msgstr "Змінювати налаштування"

#: includes/class-simple-seo-access.php:118
msgid "Open this page and change any Simple SEO settings. Administrators always can."
msgstr "Відкривати цю сторінку й змінювати будь-які налаштування Simple SEO. Адміністратори можуть завжди."

#: includes/class-simple-seo-access.php:121
msgid "Edit SEO fields"
msgstr "Редагувати SEO-поля"

#: includes/class-simple-seo-access.php:122
msgid "The SEO title, description and other basic fields of the posts, pages and terms the user can edit anyway."
msgstr "SEO-заголовок, опис та інші основні поля записів, сторінок і термінів, які користувач і так може редагувати."

#: includes/class-simple-seo-access.php:125
msgid "Edit indexing fields"
msgstr "Редагувати поля індексації"

#: includes/class-simple-seo-access.php:126
msgid "Fields that decide whether and how search engines index a page: robots, canonical address. A wrong value can take a page out of search."
msgstr "Поля, що вирішують, чи індексують пошуковики сторінку і як: robots, канонічна адреса. Хибне значення може прибрати сторінку з пошуку."

#: includes/class-simple-seo-admin.php:32
msgid "Access"
msgstr "Доступ"

#: includes/class-simple-seo-admin.php:61
#: includes/class-simple-seo-editor.php:28
#: includes/class-simple-seo-editor.php:106
msgid "SEO"
msgstr "SEO"

#: includes/class-simple-seo-admin.php:118
msgid "Sorry, you are not allowed to access this page."
msgstr "На жаль, у вас немає доступу до цієї сторінки."

#. translators: %s: name of another SEO plugin, e.g. Yoast SEO.
#: includes/class-simple-seo-admin.php:144
#, php-format
msgid "%s is active, so Simple SEO prints nothing on the site — no titles, descriptions or other tags — and pages never get them twice. Deactivate it when you switch to Simple SEO; the settings and fields here can be prepared in the meantime."
msgstr "%s активний, тому Simple SEO нічого не виводить на сайті — ні заголовків, ні описів, ні інших тегів, — і сторінки ніколи не отримують їх двічі. Вимкніть його, коли переходитимете на Simple SEO; налаштування й поля тут можна підготувати заздалегідь."

#: includes/class-simple-seo-admin.php:194
msgid "Choose an image"
msgstr "Оберіть зображення"

#: includes/class-simple-seo-admin.php:195
msgid "Use this image"
msgstr "Використати це зображення"

#: includes/class-simple-seo-admin.php:197
msgid "Choose image"
msgstr "Обрати зображення"

#: includes/class-simple-seo-admin.php:198
msgid "Remove image"
msgstr "Прибрати зображення"

#: includes/class-simple-seo-admin.php:209
msgid "Insert structure"
msgstr "Вставити структуру"

#: includes/class-simple-seo-admin.php:219
msgid "Settings"
msgstr "Налаштування"

#. translators: %s: the title or description the page has with the saved values.
#: includes/class-simple-seo-editor.php:201
#, php-format
msgid "Now: %s"
msgstr "Зараз: %s"

#: includes/class-simple-seo-editor.php:202
msgid "Now: none from Simple SEO."
msgstr "Зараз: від Simple SEO нічого."

#: includes/class-simple-seo-github-updater.php:103
msgid "Version 0.6.0: settings for the home page, the 404 page and password-protected content, per language with wp-loc. Version 0.5.0: Open Graph and X card for link previews, with a title, description and image for social networks on each post, page and term. Version 0.4.0: canonical address, noindex and nofollow, attachment pages. Version 0.3.0: page title and meta description from fields and templates. While another SEO plugin is active, nothing is printed."
msgstr "Версія 0.6.0: налаштування головної, сторінки 404 і вмісту, захищеного паролем, — для кожної мови з wp-loc. Версія 0.5.0: Open Graph і картка X для прев'ю посилань — із заголовком, описом і зображенням для соцмереж на кожному записі, сторінці й терміні. Версія 0.4.0: канонічна адреса, noindex і nofollow, сторінки вкладень. Версія 0.3.0: заголовок сторінки й мета-опис із полів і шаблонів. Поки активний інший SEO-плагін, нічого не виводиться."

#: includes/class-simple-seo-indexing.php:58
#: includes/class-simple-seo-indexing.php:103
msgid "Indexing"
msgstr "Індексація"

#: includes/class-simple-seo-indexing.php:62
msgid "Search engines"
msgstr "Пошуковики"

#: includes/class-simple-seo-indexing.php:66
msgid "As set for this type of page"
msgstr "Як налаштовано для цього виду сторінок"

#: includes/class-simple-seo-indexing.php:67
#: includes/views/tab-indexing.php:76
msgid "Show in search results"
msgstr "Показувати в результатах пошуку"

#: includes/class-simple-seo-indexing.php:68
msgid "Hide from search results (noindex)"
msgstr "Не показувати в результатах пошуку (noindex)"

#: includes/class-simple-seo-indexing.php:73
msgid "hidden from search results"
msgstr "прихована від пошуковиків"

#: includes/class-simple-seo-indexing.php:74
msgid "shown in search results"
msgstr "показується в результатах пошуку"

#: includes/class-simple-seo-indexing.php:80
msgid "Ask search engines not to follow the links on this page (nofollow)"
msgstr "Просити пошуковики не переходити за посиланнями з цієї сторінки (nofollow)"

#: includes/class-simple-seo-indexing.php:90
msgid "Canonical address"
msgstr "Канонічна адреса"

#: includes/class-simple-seo-indexing.php:91
msgid "Only when this page repeats another one: the address of the original. Leave empty for the page's own address."
msgstr "Лише коли ця сторінка повторює іншу: адреса оригіналу. Залиште порожнім, щоб узяти власну адресу сторінки."

#: includes/class-simple-seo-social.php:59
#: includes/class-simple-seo-social.php:94
msgid "Social networks"
msgstr "Соцмережі"

#: includes/class-simple-seo-social.php:63
msgid "Title for social networks"
msgstr "Заголовок для соцмереж"

#: includes/class-simple-seo-social.php:64
msgid "How a shared link is titled on Facebook, Telegram, X and the like. Leave empty to use the SEO title."
msgstr "Як підписане посилання, коли ним діляться у Facebook, Telegram, X тощо. Залиште порожнім, щоб узяти SEO-заголовок."

#: includes/class-simple-seo-social.php:73
msgid "Description for social networks"
msgstr "Опис для соцмереж"

#: includes/class-simple-seo-social.php:74
msgid "Leave empty to use the meta description."
msgstr "Залиште порожнім, щоб узяти мета-опис."

#: includes/class-simple-seo-social.php:84
#: includes/views/tab-special.php:72
msgid "Image for social networks"
msgstr "Зображення для соцмереж"

#: includes/class-simple-seo-social.php:85
msgid "Best 1200 × 630 pixels. Without it: the featured image, then the default image from the settings."
msgstr "Найкраще 1200 × 630 пікселів. Без нього — головне зображення запису, а далі типове зображення з налаштувань."

#: includes/class-simple-seo-special.php:34
#: includes/views/tab-titles.php:31
msgid "Special pages"
msgstr "Спецсторінки"

#: includes/class-simple-seo-special.php:105
msgid "Home page"
msgstr "Головна сторінка"

#. translators: %s: title of the page set as the front page.
#: includes/class-simple-seo-special.php:108
#, php-format
msgid "The front page of the site is the page \"%s\": these settings apply to it where its own SEO fields are empty."
msgstr "Головна сайту — сторінка «%s»: ці налаштування діють для неї там, де її власні SEO-поля порожні."

#: includes/class-simple-seo-special.php:109
msgid "The front page of the site lists the latest posts."
msgstr "Головна сайту показує останні записи."

#: includes/class-simple-seo-special.php:113
msgid "Page not found (404)"
msgstr "Сторінку не знайдено (404)"

#: includes/class-simple-seo-special.php:114
msgid "Shown for addresses that lead nowhere. Search engines do not index it and social networks get no preview of it, so it has no image. {title} here is \"Page not found\" in the language of the page."
msgstr "Показується за адресами, що ведуть у нікуди. Пошуковики її не індексують, а соцмережі не отримують її прев'ю, тож зображення в неї немає. {title} тут — «Сторінку не знайдено» мовою сторінки."

#: includes/class-simple-seo-special.php:117
msgid "Password-protected content"
msgstr "Вміст, захищений паролем"

#: includes/class-simple-seo-special.php:118
msgid "A post or page protected with a password shows only the password form until the visitor enters it. Meanwhile these templates replace those of its post type, and its featured image and excerpt stay hidden; an SEO title, description or image of its own still wins. {title} here is the post title."
msgstr "Запис чи сторінка під паролем показує лише форму пароля, доки відвідувач його не введе. Тим часом ці шаблони заміняють шаблони його типу запису, а головне зображення й витяг лишаються прихованими; власні SEO-заголовок, опис чи зображення запису все одно мають перевагу. {title} тут — назва запису."

#: includes/class-simple-seo-titles.php:53
msgid "SEO title"
msgstr "SEO-заголовок"

#: includes/class-simple-seo-titles.php:54
msgid "The title search engines show. Leave empty to use the template; variables like {title}, {sep} and {site} work here too."
msgstr "Заголовок, який показують пошуковики. Залиште порожнім, щоб узяти шаблон; змінні на кшталт {title}, {sep} і {site} працюють і тут."

#: includes/class-simple-seo-titles.php:63
msgid "Meta description"
msgstr "Мета-опис"

#: includes/class-simple-seo-titles.php:64
msgid "The text under the title in search results. Leave empty to use the template."
msgstr "Текст під заголовком у результатах пошуку. Залиште порожнім, щоб узяти шаблон."

#: includes/class-simple-seo-titles.php:74
msgid "Titles"
msgstr "Заголовки"

#. translators: %s: post type name, plural.
#: includes/class-simple-seo-titles.php:269
#, php-format
msgid "Archive: %s"
msgstr "Архів: %s"

#: includes/class-simple-seo-titles.php:272
msgid "Author archives"
msgstr "Архіви авторів"

#: includes/class-simple-seo-titles.php:273
msgid "Date archives"
msgstr "Архіви за датами"

#: includes/class-simple-seo-titles.php:274
msgid "Search results"
msgstr "Результати пошуку"

#: includes/class-simple-seo-titles.php:278
msgid "Post types"
msgstr "Типи записів"

#: includes/class-simple-seo-titles.php:282
msgid "Taxonomies"
msgstr "Таксономії"

#: includes/class-simple-seo-titles.php:286
msgid "Archives and search"
msgstr "Архіви й пошук"

#: includes/class-simple-seo-variables.php:46
msgid "Title of the post, term, archive or author; on search results and 404 a ready phrase"
msgstr "Назва запису, терміна чи архіву або ім'я автора; на сторінках пошуку й 404 — готова фраза"

#: includes/class-simple-seo-variables.php:47
msgid "Site title"
msgstr "Назва сайту"

#: includes/class-simple-seo-variables.php:48
msgid "Tagline"
msgstr "Короткий опис сайту"

#: includes/class-simple-seo-variables.php:49
msgid "Separator chosen in the settings"
msgstr "Роздільник, обраний у налаштуваннях"

#: includes/class-simple-seo-variables.php:50
msgid "Page number, only from the second page on: \"Page 2 of 5\""
msgstr "Номер сторінки, лише з другої: «Сторінка 2 з 5»"

#: includes/class-simple-seo-variables.php:51
msgid "Excerpt of the post (or the start of its text), description of the term, author or post type"
msgstr "Витяг запису (або початок його тексту), опис терміна, автора чи типу записів"

#: includes/class-simple-seo-variables.php:52
msgid "Category of the post"
msgstr "Рубрика запису"

#: includes/class-simple-seo-variables.php:53
msgid "Author name"
msgstr "Ім'я автора"

#: includes/class-simple-seo-variables.php:54
msgid "Publication date of the post, or the date of a date archive"
msgstr "Дата публікації запису або дата архіву за датами"

#: includes/class-simple-seo-variables.php:55
msgid "Name of the post type"
msgstr "Назва типу записів"

#: includes/class-simple-seo-variables.php:56
msgid "What was searched for"
msgstr "Що шукали"

#: includes/class-simple-seo-variables.php:57
msgid "Current year"
msgstr "Поточний рік"

#. translators: %s: what was searched for.
#: includes/class-simple-seo-variables.php:114
#, php-format
msgid "Search results for \"%s\""
msgstr "Результати пошуку за «%s»"

#: includes/class-simple-seo-variables.php:116
msgid "Page not found"
msgstr "Сторінку не знайдено"

#. translators: 1: page number, 2: number of pages.
#: includes/class-simple-seo-variables.php:131
#, php-format
msgid "Page %1$d of %2$d"
msgstr "Сторінка %1$d з %2$d"

#. translators: %d: page number.
#: includes/class-simple-seo-variables.php:133
#, php-format
msgid "Page %d"
msgstr "Сторінка %d"

#. translators: format of a month archive date, see https://www.php.net/manual/datetime.format.php
#: includes/class-simple-seo-variables.php:214
msgctxt "month archive date format"
msgid "F Y"
msgstr "F Y"

#: includes/views/tab-access.php:14
msgid "Choose which roles can do what. Editing SEO fields of a post or term also needs the right to edit that post or term itself."
msgstr "Оберіть, які ролі що можуть. Щоб редагувати SEO-поля запису чи терміна, потрібне ще й право редагувати сам запис чи термін."

#: includes/views/tab-indexing.php:16
#: includes/views/tab-indexing.php:32
msgid "Attachment pages"
msgstr "Сторінки вкладень"

#: includes/views/tab-indexing.php:18
msgid "Choose which kinds of pages search engines may show. A hidden kind gets \"noindex\"; links on it are still followed. Each post, page or term can override its kind in its own SEO fields. Search results and the 404 page are always hidden."
msgstr "Оберіть, які види сторінок можуть показувати пошуковики. Прихований вид отримує «noindex», але посилання з нього пошуковики все одно проходять. Кожен запис, сторінка чи термін може перевизначити це у своїх SEO-полях. Результати пошуку й сторінка 404 приховані завжди."

#. translators: %s: link to Settings → Reading.
#: includes/views/tab-indexing.php:25
#, php-format
msgid "The whole site is hidden from search engines in %s, whatever is chosen here."
msgstr "Увесь сайт приховано від пошуковиків у %s, що б тут не було обрано."

#: includes/views/tab-indexing.php:26
msgid "Settings → Reading"
msgstr "Налаштування → Читання"

#: includes/views/tab-indexing.php:36
#: includes/views/tab-indexing.php:39
msgid "An attachment page"
msgstr "Сторінка вкладення"

#: includes/views/tab-indexing.php:42
msgid "redirects to the file itself (recommended)"
msgstr "веде на сам файл (рекомендовано)"

#: includes/views/tab-indexing.php:43
msgid "redirects to the post it is attached to, or to the file when there is none"
msgstr "веде на запис, до якого прикріплено файл, а якщо такого немає — на сам файл"

#: includes/views/tab-indexing.php:44
msgid "stays a page of its own"
msgstr "лишається окремою сторінкою"

#: includes/views/tab-indexing.php:52
msgid "WordPress makes a page for every uploaded file. It has nothing but the image, so search engines rate it as thin content."
msgstr "WordPress створює сторінку для кожного завантаженого файлу. На ній немає нічого, крім зображення, тож пошуковики вважають її порожньою сторінкою."

#: includes/views/tab-social.php:14
msgid "When a page is shared on Facebook, Telegram, Viber, LinkedIn, X and the like, the preview shows its title, description and image: the SEO title and meta description, unless a post or term has its own for social networks."
msgstr "Коли сторінкою діляться у Facebook, Telegram, Viber, LinkedIn, X тощо, прев'ю показує її заголовок, опис і зображення: SEO-заголовок і мета-опис, якщо запис чи термін не має власних для соцмереж."

#: includes/views/tab-social.php:19
msgid "Default image"
msgstr "Типове зображення"

#: includes/views/tab-social.php:24
msgid "For pages without an image of their own or a featured image: a logo or a picture of the site, best 1200 × 630 pixels."
msgstr "Для сторінок без власного чи головного зображення: логотип або картинка сайту, найкраще 1200 × 630 пікселів."

#: includes/views/tab-social.php:28
msgid "X account"
msgstr "Акаунт X"

#: includes/views/tab-social.php:31
msgid "Optional: the site's account on X (Twitter), as @name or a link to it."
msgstr "Необов'язково: акаунт сайту в X (Twitter) — як @ім'я або посилання на нього."

#: includes/views/tab-special.php:17
msgid "The home page, the page for addresses that lead nowhere and content behind a password get their title and description from the templates below. Variables work as on the Titles tab; an empty template leaves the page with the theme's title and without a description."
msgstr "Головна сторінка, сторінка для адрес, що ведуть у нікуди, і вміст під паролем беруть заголовок і опис із шаблонів нижче. Змінні працюють так само, як на вкладці «Заголовки»; порожній шаблон лишає сторінці заголовок теми й залишає її без опису."

#. translators: %s: language name, e.g. English.
#: includes/views/tab-special.php:25
#, php-format
msgid "These settings are kept for each language. You are editing them for: %s. Switch the language in the admin bar to edit another one; a language not saved here yet uses the settings of the default language."
msgstr "Ці налаштування зберігаються для кожної мови окремо. Ви редагуєте їх для: %s. Щоб редагувати іншу мову, перемкніть її на панелі адміністратора; мова, для якої тут ще нічого не збережено, бере налаштування основної мови."

#: includes/views/tab-special.php:41
msgid "Edit the page"
msgstr "Редагувати сторінку"

#: includes/views/tab-special.php:48
#: includes/views/tab-titles.php:75
msgid "Title template"
msgstr "Шаблон заголовка"

#: includes/views/tab-special.php:49
#: includes/views/tab-titles.php:76
msgid "Description template"
msgstr "Шаблон опису"

#: includes/views/tab-special.php:77
msgid "Without it: the default image from the Social networks tab."
msgstr "Без нього — типове зображення з вкладки «Соцмережі»."

#: includes/views/tab-titles.php:25
msgid "Templates decide the title and the description of every page that has no SEO title or description of its own. Variables in curly braces are replaced on each page; a variable with nothing to show disappears together with the separator next to it. An empty template leaves the page with the theme's title and without a description."
msgstr "Шаблони визначають заголовок і опис кожної сторінки, яка не має власного SEO-заголовка чи опису. Змінні у фігурних дужках замінюються на кожній сторінці; змінна, якій нічого показати, зникає разом із роздільником поруч. Порожній шаблон лишає сторінці заголовок теми й не дає їй опису."

#. translators: %s: link to the Special pages tab.
#: includes/views/tab-titles.php:30
#, php-format
msgid "The home page, the 404 page and password-protected content have their own templates on the %s tab."
msgstr "Головна сторінка, сторінка 404 і вміст, захищений паролем, мають власні шаблони на вкладці «%s»."

#: includes/views/tab-titles.php:41
#: includes/views/tab-titles.php:44
msgid "Separator"
msgstr "Роздільник"

#: includes/views/tab-titles.php:53
msgid "Goes where a template says {sep}."
msgstr "Стоїть там, де в шаблоні {sep}."

#: includes/views/variables.php:22
msgid "Variables"
msgstr "Змінні"
