msgstr "Такої частини немає: %1$s. Частини: %2$s."

#. translators: 1: a part of a plugin's data, e.g. postmeta; 2: files of the theme.
#: includes/class-simple-seo-cli.php:359
#, php-format
msgid "Kept, as the active theme reads it: %1$s (%2$s)."
msgstr "Залишено, бо активна тема це читає: %1$s (%2$s)."

#. translators: 1: a part of a plugin's data, e.g. postmeta; 2: files of the theme.
#: includes/class-simple-seo-cli.php:362
#, php-format
msgid "The active theme reads %1$s (%2$s): removed, it is gone for the theme too."
msgstr "Активна тема читає %1$s (%2$s): після видалення тема цього вже не знайде."

#: includes/class-simple-seo-cli.php:393
